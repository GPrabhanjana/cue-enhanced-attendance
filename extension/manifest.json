{
  "manifest_version": 2,
  "name": "CUE Enhanced Attendance",
  "version": "1.9.1",
  "description": "Unofficial helper for the CHRIST University CUE portal: effective attendance (co-curricular and medical leave) and how many classes you need or can skip to reach your target. Runs only in your browser.",
  "homepage_url": "https://gprabhanjana.netlify.app/",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cue-enhanced-attendance@prabhanjana",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "browser_action": {
    "default_title": "CUE Enhanced Attendance",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://cue.christuniversity.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    }
  ]
}
